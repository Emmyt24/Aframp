# ──────────────────────────────────────────────────────────────────────────────
# Aframp Environment Variables
# ──────────────────────────────────────────────────────────────────────────────

# ── Next.js ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── M-Pesa (Daraja API) ───────────────────────────────────────────────────────
# Obtain from https://developer.safaricom.co.ke/
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
MPESA_ENV=sandbox  # sandbox | production

# ── MTN Mobile Money (MoMo) ───────────────────────────────────────────────────
# Obtain from https://momodeveloper.mtn.com/
MTN_MOMO_SUBSCRIPTION_KEY=your_subscription_key_here
MTN_MOMO_API_USER=your_api_user_uuid_here
MTN_MOMO_API_KEY=your_api_key_here
MTN_MOMO_ENV=sandbox  # sandbox | production

# ── Vercel (CI/CD) ────────────────────────────────────────────────────────────
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ── Sentry (Error Tracking) ───────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Lighthouse CI ─────────────────────────────────────────────────────────────
LHCI_GITHUB_APP_TOKEN=
# ── Upstash Redis — required for API rate limiting (100 req/min per IP)
# Get these from https://console.upstash.com after creating a Redis database
UPSTASH_REDIS_REST_URL=https://<your-upstash-redis-url>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-redis-token>

# ── Alchemy (on-chain balance fetching) ───────────────────────────────────────
# Required for fetching live ETH wallet balances.
# Sign up at https://www.alchemy.com → Create App → Ethereum Mainnet → copy the API key.
# Without this key, on-chain balance fetching is skipped gracefully.
NEXT_PUBLIC_ALCHEMY_API_KEY=your_alchemy_api_key_here

# ── PostHog (event-level analytics) ──────────────────────────────────────────
# Required for funnel analytics (onramp, KYC, bill payment events).
# Sign up at https://posthog.com → Project Settings → Project API Key.
# If not set, analytics events are silently no-op'd (safe for local dev).
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key
# Optional: override the PostHog ingest host (e.g. for EU region or self-hosted)
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
