# ══════════════════════════════════════════════════════════════════════════════
# AFRAMP Environment Variables
#
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is already listed in .gitignore.
#
# Naming convention:
#   NEXT_PUBLIC_*  → bundled into the browser build (visible to users)
#   Everything else → server-side only (Node.js / Edge runtime)
#
# Variables marked [REQUIRED] must be set before the app starts.
# Variables marked [OPTIONAL] fall back to documented defaults when absent.
# ══════════════════════════════════════════════════════════════════════════════


# ── App / Next.js ─────────────────────────────────────────────────────────────

# Base URL of the running application (no trailing slash).
# Used for callback URLs, og-image generation, and internal API calls.
# [REQUIRED]
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Alias used by some legacy helpers. Keep in sync with NEXT_PUBLIC_APP_URL.
# [OPTIONAL] default: http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Enable demo/mock mode. Bypasses wallet auth and uses fake addresses.
# MUST be false in production — setting true in prod is a security risk.
# [REQUIRED]
NEXT_PUBLIC_DEMO_MODE=true


# ── Stellar Network ───────────────────────────────────────────────────────────
# Horizon RPC docs: https://developers.stellar.org/network/horizon

# Default network for the Stellar SDK ("PUBLIC" | "TESTNET").
# [OPTIONAL] default: TESTNET in development, PUBLIC in production
NEXT_PUBLIC_STELLAR_NETWORK=TESTNET

# Custom Horizon server URL (leave blank to use the official public endpoint).
# [OPTIONAL] default: https://horizon-testnet.stellar.org (TESTNET)
#            or       https://horizon.stellar.org         (PUBLIC)
NEXT_PUBLIC_STELLAR_HORIZON_URL=

# ── Stellar Asset Issuers ─────────────────────────────────────────────────────
# Each issuer is the Stellar G-address of the account that issued the token.
# Testnet addresses are pre-filled; replace with mainnet values for production.

# cNGN — Nigerian Naira stablecoin on Stellar
# [REQUIRED] for NGN onramp / offramp
NEXT_PUBLIC_CNGN_ISSUER=GAHJJJKMOKYE4RVPZEWZTKH5FVI4PA3VL7GK2LFNUBSGBV3TNFWQQE

# cKES — Kenyan Shilling stablecoin on Stellar
# [OPTIONAL] leave blank to disable KES support
NEXT_PUBLIC_CKES_ISSUER=

# cGHS — Ghanaian Cedi stablecoin on Stellar
# [OPTIONAL] leave blank to disable GHS support
NEXT_PUBLIC_CGHS_ISSUER=

# cZAR — South African Rand stablecoin on Stellar
# [OPTIONAL] leave blank to disable ZAR support
NEXT_PUBLIC_CZAR_ISSUER=

# cUGX — Ugandan Shilling stablecoin on Stellar
# [OPTIONAL] leave blank to disable UGX support
NEXT_PUBLIC_CUGX_ISSUER=

# USDC on Stellar (Circle's official issuer)
# Testnet: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
# Mainnet: GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
# [OPTIONAL] default hard-coded fallback used when blank
NEXT_PUBLIC_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# EURC on Stellar (Circle Euro)
# [OPTIONAL] leave blank to disable EURC support
NEXT_PUBLIC_EURC_ISSUER=


# ── Paystack (Card Payments — Nigeria & Ghana) ────────────────────────────────
# Sign up: https://paystack.com → Settings → API Keys & Webhooks
# Use pk_test_ / sk_test_ for development; pk_live_ / sk_live_ for production.

# Public key — safe to expose in the browser
# [OPTIONAL] required only when card payments are enabled
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key — server-side only, never expose to the browser
# [OPTIONAL] required only when card payments are enabled
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook secret used to verify Paystack webhook signatures
# [OPTIONAL] strongly recommended in production
PAYSTACK_WEBHOOK_SECRET=


# ── Flutterwave (Mobile Money & Cards — pan-Africa) ───────────────────────────
# Sign up: https://flutterwave.com → Settings → API
# Use TEST keys for development and LIVE keys for production.

# Public key — safe to expose in the browser
# [OPTIONAL] required only when Flutterwave payments are enabled
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Secret key — server-side only
# [OPTIONAL] required only when Flutterwave payments are enabled
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Encryption key — used to encrypt card payload
# [OPTIONAL] required only when Flutterwave direct-charge is used
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxxxxxxxxxx

# Webhook secret hash for verifying Flutterwave webhook payloads
# [OPTIONAL] strongly recommended in production
FLUTTERWAVE_WEBHOOK_HASH=


# ── M-Pesa / Daraja API (Kenya, Tanzania, Uganda, Ghana) ─────────────────────
# Developer portal: https://developer.safaricom.co.ke/
# Set MPESA_ENV=sandbox for development, MPESA_ENV=production for live.

# OAuth client credentials from the Daraja developer portal
# [OPTIONAL] required only when M-Pesa payments are enabled
MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here

# Business short code (Paybill or Till Number)
# Sandbox default: 174379
# [OPTIONAL] required only when M-Pesa payments are enabled
MPESA_SHORTCODE=174379

# Lipa Na M-Pesa Online passkey (provided by Safaricom)
# [OPTIONAL] required only when STK Push is used
MPESA_PASSKEY=your_passkey_here

# "sandbox" or "production"
# [OPTIONAL] default: sandbox
MPESA_ENV=sandbox


# ── MTN Mobile Money (MoMo) — West & Central Africa ──────────────────────────
# Developer portal: https://momodeveloper.mtn.com/
# Set MTN_MOMO_ENV=sandbox for development, MTN_MOMO_ENV=production for live.

# Primary subscription key from the MTN developer portal
# [OPTIONAL] required only when MTN MoMo payments are enabled
MTN_MOMO_SUBSCRIPTION_KEY=your_subscription_key_here

# UUID of the API user (created via the provisioning API or portal)
# [OPTIONAL] required only when MTN MoMo payments are enabled
MTN_MOMO_API_USER=your_api_user_uuid_here

# API key tied to the API user above
# [OPTIONAL] required only when MTN MoMo payments are enabled
MTN_MOMO_API_KEY=your_api_key_here

# Base URL for MoMo collection API (leave blank to use MTN defaults per env)
# [OPTIONAL]
MTN_MOMO_BASE_URL=

# "sandbox" or "production"
# [OPTIONAL] default: sandbox
MTN_MOMO_ENV=sandbox

# Target environment header value sent with every MoMo request
# sandbox → "sandbox", production → your registered environment name
# [OPTIONAL] default: sandbox
MTN_MOMO_TARGET_ENV=sandbox


# ── Upstash Redis (Rate Limiting & Caching) ───────────────────────────────────
# Create a Redis database: https://console.upstash.com
# Used by @upstash/ratelimit for per-IP API rate limiting (100 req/min).

# [REQUIRED in production] leave blank to disable rate limiting in development
UPSTASH_REDIS_REST_URL=https://<your-db-name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>


# ── Alchemy (EVM RPC & Webhooks) ──────────────────────────────────────────────
# Create an app: https://dashboard.alchemy.com
# Required for multi-chain features (Ethereum, Polygon, Base, etc.)

# Alchemy API key — used for all network RPC calls
# [OPTIONAL] required only when EVM chain support is enabled
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Ethereum mainnet RPC URL (auto-built from ALCHEMY_API_KEY when blank)
# [OPTIONAL]
NEXT_PUBLIC_ALCHEMY_ETH_URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here

# Polygon mainnet RPC URL
# [OPTIONAL]
NEXT_PUBLIC_ALCHEMY_POLYGON_URL=https://polygon-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here

# Base mainnet RPC URL
# [OPTIONAL]
NEXT_PUBLIC_ALCHEMY_BASE_URL=https://base-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here

# Alchemy webhook signing key (for verifying Alchemy notify webhooks)
# [OPTIONAL]
ALCHEMY_WEBHOOK_SIGNING_KEY=


# ── Sentry (Error Tracking & Performance Monitoring) ─────────────────────────
# Create a project: https://sentry.io → Project Settings → Client Keys (DSN)

# Public DSN — safe to expose in the browser (used by sentry.client.config.ts)
# [OPTIONAL] errors will not be tracked when blank
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Server-side DSN (can be same as public DSN)
# [OPTIONAL]
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Auth token for uploading source maps during CI build
# Generate at: https://sentry.io → Settings → Auth Tokens
# [OPTIONAL] source maps will not be uploaded when blank
SENTRY_AUTH_TOKEN=

# Sentry organisation slug (visible in your Sentry URL: sentry.io/organizations/<slug>)
# [OPTIONAL] required when using sentry-cli or source-map upload
SENTRY_ORG=your-org-slug

# Sentry project slug
# [OPTIONAL] required when using sentry-cli or source-map upload
SENTRY_PROJECT=aframp


# ── Axiom (Structured Log Ingestion) ─────────────────────────────────────────
# Create a dataset: https://app.axiom.co → Datasets
# Logs fall back to the local console when these are absent.

# Axiom ingest token (requires ingest permission on the dataset)
# [OPTIONAL] logs will go to the console when blank
AXIOM_TOKEN=xaat-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Axiom dataset name to ingest logs into
# [OPTIONAL] default: aframp
AXIOM_DATASET=aframp


# ── Vercel (CI/CD & Deployments) ─────────────────────────────────────────────
# Required only for programmatic Vercel API usage (e.g. custom deploy scripts).
# Standard Vercel deployments read these automatically from the project settings.

# [OPTIONAL]
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# Injected automatically by Vercel; used for Sentry release tagging.
# Do NOT set manually — Vercel sets this per deployment.
# NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA=


# ── Lighthouse CI ─────────────────────────────────────────────────────────────
# Required only for automated Lighthouse audits in CI.

# [OPTIONAL]
LHCI_GITHUB_APP_TOKEN=


# ── WebSocket / Real-time ─────────────────────────────────────────────────────

# WebSocket URL for real-time bill payment status updates.
# Use ws:// for local dev, wss:// for production (TLS required).
# [OPTIONAL] polling fallback used when blank
NEXT_PUBLIC_BILLS_WS_URL=ws://localhost:8080
