# ──────────────────────────────────────────────────────────────────────────────
# Aframp — Environment Variables Template
#
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
#
# Full documentation: docs/ENVIRONMENT_VARIABLES.md
# ──────────────────────────────────────────────────────────────────────────────


# ── Core / Next.js ────────────────────────────────────────────────────────────

# Base URL for internal API routes (client-side fetch calls)
NEXT_PUBLIC_API_URL=http://localhost:3000

# Set to true locally for mock wallets; MUST be false in production
NEXT_PUBLIC_DEMO_MODE=true


# ── Stellar Asset Issuers ─────────────────────────────────────────────────────
# 56-character Stellar addresses (start with G) for each supported stablecoin.
# Testnet issuers are provided as defaults for development.

# cNGN — Nigerian Naira stablecoin
NEXT_PUBLIC_CNGN_ISSUER=GCKFBEIYV2U22IO2BJ4KVJOIP7XPWQGQFKKWXR6DOSJBV7STMAQSMTGG

# USDC — Circle's official Stellar USDC issuer
NEXT_PUBLIC_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# cKES — Kenyan Shilling stablecoin
NEXT_PUBLIC_CKES_ISSUER=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# cGHS — Ghanaian Cedi stablecoin
NEXT_PUBLIC_CGHS_ISSUER=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX


# ── Paystack (Card Payments) ──────────────────────────────────────────────────
# Sign up at https://paystack.com → Settings → API Keys & Webhooks

# Public key — safe to expose in the browser
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_YOUR_PUBLIC_KEY_HERE

# Secret key — server-side only, NEVER expose to the browser
PAYSTACK_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE


# ── Flutterwave (Mobile Money & Cards) ───────────────────────────────────────
# Sign up at https://flutterwave.com → Settings → API

# Public key — safe to expose in the browser
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Secret key — server-side only
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-X

# Encryption key — server-side only
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxxxxxxxxxx


# ── M-Pesa / Daraja API ───────────────────────────────────────────────────────
# Register at https://developer.safaricom.co.ke/
# All five variables are required for M-Pesa STK Push payments.

MPESA_CONSUMER_KEY=your_consumer_key_here
MPESA_CONSUMER_SECRET=your_consumer_secret_here
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your_passkey_here
# sandbox | production
MPESA_ENV=sandbox


# ── MTN Mobile Money (MoMo) ───────────────────────────────────────────────────
# Register at https://momodeveloper.mtn.com/
# All four variables are required for MTN MoMo Collections.

MTN_MOMO_SUBSCRIPTION_KEY=your_subscription_key_here
MTN_MOMO_API_USER=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MTN_MOMO_API_KEY=your_api_key_here
# sandbox | production
MTN_MOMO_ENV=sandbox


# ── Upstash Redis (Rate Limiting & Caching) ───────────────────────────────────
# Required for API rate limiting (100 req/min per IP).
# Create a database at https://console.upstash.com

UPSTASH_REDIS_REST_URL=https://<your-db-name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-redis-token>


# ── Sentry (Error Tracking) ───────────────────────────────────────────────────
# https://sentry.io → Settings → Projects → Client Keys (DSN)

# Client-side DSN (public)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0

# Server-side DSN (secret)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@o0.ingest.sentry.io/0

# Auth token for source-map uploads during build (CI secret — do not commit)
SENTRY_AUTH_TOKEN=

# Your Sentry organisation slug
SENTRY_ORG=

# Your Sentry project slug
SENTRY_PROJECT=


# ── Vercel (Deployment CI/CD) ─────────────────────────────────────────────────
# Set these as GitHub Actions secrets, NOT in .env.local.
# Listed here for documentation purposes only.

VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=


# ── Lighthouse CI ─────────────────────────────────────────────────────────────
# GitHub App token for Lighthouse CI status checks.
# Set as a GitHub Actions secret.

LHCI_GITHUB_APP_TOKEN=


# ── Codecov ───────────────────────────────────────────────────────────────────
# Upload token for test-coverage reporting.
# Set as a GitHub Actions secret.

CODECOV_TOKEN=


# ── Optional Features ─────────────────────────────────────────────────────────

# WebSocket URL for real-time bill payment status updates.
# Leave empty to disable WebSocket features and fall back to polling.
NEXT_PUBLIC_BILLS_WS_URL=
